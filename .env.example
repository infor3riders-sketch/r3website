# --- Supabase (one project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser. Used for invites, webhooks, guest order/donation creation.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hosts (include the port in local dev) ---
NEXT_PUBLIC_SITE_HOST=localhost:3000
NEXT_PUBLIC_PORTAL_HOST=portal.localhost:3000
# Use https in production, http locally
NEXT_PUBLIC_SITE_PROTOCOL=http

# --- Payments: manual | paymongo ---
PAYMENT_PROVIDER=manual
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="R3 Riders <no-reply@r3riders.org>"

# --- Cloudflare Turnstile (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Signing secret for guest order-lookup tokens (>= 32 chars) ---
ORDER_TOKEN_SECRET=

# --- Vercel Cron auth (any long random string; Vercel sends it as a Bearer token) ---
CRON_SECRET=
